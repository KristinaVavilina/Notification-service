    <PackageReference Include="Polly" Version="8.6.5" />
    <PackageReference Include="RabbitMQ.Client" Version="6.5.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Libs\DatabaseConnectionLib\DatabaseConnectionLib.csproj" />
    <ProjectReference Include="..\Libs\MessageQueueConnectionLib\MessageQueueConnectionLib.csproj" />
    <ProjectReference Include="..\Libs\MonitoringConnectionLib\MonitoringConnectionLib.csproj" />
  </ItemGroup>

</Project>
