  "GetCurrentStatusUri": "http://databaseservice.api:8080/messages/status",
  "GetStatusHistoryUri": "http://databaseservice.api:8080/messages/status/history",
  "StoreMessageUri": "http://databaseservice.api:8080/messages/store",
  "UpdateStatusUri": "http://databaseservice.api:8080/messages/status",
